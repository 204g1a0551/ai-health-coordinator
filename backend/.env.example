# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=

# Cache and Reservation TTLs (in seconds)
REDIS_HOLD_TTL_SECONDS=600               # 10 minutes hold for temporary appointment reservations
REDIS_SESSION_TTL_SECONDS=86400          # 24 hours for chat session memory
REDIS_CACHE_TTL_SECONDS=3600             # 1 hour for directory cache
AVAILABILITY_CACHE_TTL_SECONDS=60        # 60 seconds near-real-time availability cache
SLOT_LOCK_TTL_SECONDS=300                # 5 minutes temporary reservation lock

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=health_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_URL=

# LLM Configuration (Optional - if omitted, runs using built-in deterministic NLU engine)
GEMINI_API_KEY=
